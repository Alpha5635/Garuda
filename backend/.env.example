# App Configuration
PROJECT_NAME="LabelSetu Backend"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-secure-random-secret-key-here"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# JWT Authentication
JWT_SECRET_KEY="generate-a-secure-jwt-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="garuda_user"
POSTGRES_PASSWORD="garuda_secure_password"
POSTGRES_DB="labelsetu_db"
DATABASE_URL="postgresql+asyncpg://garuda_user:garuda_secure_password@localhost:5432/labelsetu_db"
SYNC_DATABASE_URL="postgresql+psycopg2://garuda_user:garuda_secure_password@localhost:5432/labelsetu_db"

# Redis & Celery
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Object Storage (MinIO / S3)
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="labelsetu-evidence"
S3_REGION="us-east-1"
S3_SECURE=false

# Quality & OCR Engine Thresholds
BLUR_THRESHOLD=100.0
GLARE_THRESHOLD=0.15
MIN_IMAGE_WIDTH=400
MIN_IMAGE_HEIGHT=400
