# Environment variables for Garuda Database Layer

# Application Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA&sslmode=prefer
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garuda_db?schema=public"

# Direct URL for migrations (useful when using connection pooling proxies like Supabase / PgBouncer / Neon)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/garuda_db?schema=public"

# Database Configuration for Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=garuda_db
POSTGRES_PORT=5432
