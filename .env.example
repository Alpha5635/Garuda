# LabelSetu Environment Variables Template

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="LabelSetu Database Engine"
API_V1_STR=/api/v1

# PostgreSQL + PostGIS Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=labelsetu_admin
POSTGRES_PASSWORD=labelsetu_secure_pass_2026
POSTGRES_DB=labelsetu
DATABASE_URL=postgresql+psycopg2://labelsetu_admin:labelsetu_secure_pass_2026@localhost:5432/labelsetu

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret_2026
MINIO_USE_SSL=False
MINIO_BUCKET_EVIDENCE=labelsetu-evidence
MINIO_BUCKET_REPORTS=labelsetu-reports
MINIO_BUCKET_SNAPSHOTS=labelsetu-snapshots

# Redis (Celery & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security & Audit
SECRET_KEY=secret_key_labelsetu_sih_2026_dev_env_only_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
AUDIT_SALT=labelsetu_audit_chain_salt_2026
